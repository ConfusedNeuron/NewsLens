# ─────────────────────────────────────────────────────────────────────────────
# LLM provider (required)
#
# Despite the variable name, this is just "the API key for whichever
# OpenAI-compatible provider you're using". The name is historical.
#
# The DEFAULT provider is NVIDIA NIM — https://build.nvidia.com → API Keys.
# A NIM key looks like:  nvapi-xxxxxxxx...
#
# To use a different provider, set BOTH the key and LLM_BASE_URL:
#   NVIDIA NIM    https://integrate.api.nvidia.com/v1     (default, $1 free credit)
#   OpenRouter    https://openrouter.ai/api/v1            (has :free models)
#   Groq          https://api.groq.com/openai/v1          (free, fast)
#   Together AI   https://api.together.xyz/v1             ($25 free)
#
# The model itself is set by ACTIVE_MODEL in config/settings.py, not here.
# Check which model IDs your account can see:  python testapi.py --list-models
# ─────────────────────────────────────────────────────────────────────────────
COMMANDCODE_API_KEY=
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# ─────────────────────────────────────────────────────────────────────────────
# Optional integrations — everything below degrades gracefully when unset
# ─────────────────────────────────────────────────────────────────────────────

# US macro data (Fed funds, CPI, GDP, unemployment) on cards.
# Free and instant: https://fred.stlouisfed.org/docs/api/api_key.html
# Without this, no card carries macro data.
FRED_API_KEY=

# Reddit ingest. Create an app at https://reddit.com/prefs/apps (type: script).
# Reddit sources stay disabled in config/sources.yaml until these are set.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=newslens/1.0

# ─────────────────────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./newslens.db
PIPELINE_INTERVAL_HOURS=6
PORT=8000

# Comma-separated allowed origins for the API. Defaults to local dev ports.
# CORS_ORIGINS=http://localhost:5173

# Set to 0 to stop the background pipeline job starting with the API —
# useful when you want to trigger runs manually.
# ENABLE_SCHEDULER=1
